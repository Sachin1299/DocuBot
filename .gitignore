# ==============================
# Java / Spring Boot (Backend)
# ==============================
/backend/target/
/backend/.classpath
/backend/.project
/backend/.settings/
/backend/*.iml
/backend/.idea/
/backend/src/main/resources/application.properties

# Logs
/backend/*.log
/backend/logs/
/backend/*.tmp

# OS files
/backend/.DS_Store

# IDE
/backend/.vscode/

# ==============================
# Node.js / React (Frontend)
# ==============================
/Frontend/node_modules/
/Frontend/build/
/Frontend/.env.local
/Frontend/.env.development.local
/Frontend/.env.test.local
/Frontend/.env.production.local
/Frontend/.DS_Store
/Frontend/npm-debug.log*
/Frontend/yarn-debug.log*
/Frontend/yarn-error.log*
/Frontend/.eslintcache

# IDE
/Frontend/.idea/
/Frontend/.vscode/
/Frontend/*.iml

# ==============================
# Root-level ignores (optional)
# ==============================
*.log
*.tmp
.env
*.iml
*.swp
.DS_Store
.idea/
.vscode/
*.class
